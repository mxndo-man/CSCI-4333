    & \langle eid, cid, s \rangle \in \text{works} \land \\
    & \langle cid, \text{'First Bank Corporation'}, cc \rangle \in \text{company} 
) \}
\end{aligned}
\]


\subsection*{3.3 Find the names, street addresses, and cities of residence of all
employees who work for First Bank Corporation and earn more than \text{$10,000$}}
\textbf{1}
\[
\pi_{\text{employee-name}, \text{street}, \text{city}} \left( 
    \sigma_{\substack{
        \text{employee.employee-id}=\text{works.employee-id} \wedge \\
        \text{works.company-id}=\text{company.company-id} \wedge \\
        \text{company.company-name}=\text{'First Bank Corporation'} \wedge \\
        \text{works.salary} > 10000
    }} 
    (\text{employee} \times \text{works} \times \text{company}) 
\right)
\]
\textbf{2}
\[
\begin{aligned}
\{ t \mid \exists e \in \text{employee}, \exists w \in \text{works}, \exists c \in \text{company} \, ( 
    & t[\text{employee-name}] = e[\text{employee-name}] \land \\
    & t[\text{street}] = e[\text{street}] \land \\
    & t[\text{city}] = e[\text{city}] \land \\
    & e[\text{employee-id}] = w[\text{employee-id}] \land \\
    & w[\text{company-id}] = c[\text{company-id}] \land \\
    & c[\text{company-name}] = \text{'First Bank Corporation'} \land \\
    & w[\text{salary}] > 10000 
) \}
\end{aligned}
\]
\textbf{3}
\[
\begin{aligned}
\{ \langle e, st, cy \rangle \mid \exists eid, cid, s, c \, ( 
    & \langle eid, e, st, cy \rangle \in \text{employee} \land \\
    & \langle eid, cid, s \rangle \in \text{works} \land \\
    & \langle cid, \text{'First Bank Corporation'}, c \rangle \in \text{company} \land \\
    & s > 10000 
) \}
\end{aligned}
\]

