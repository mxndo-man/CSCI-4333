\subsection*{3.6: Find all employees in the database who do not work for the First
Bank Corporation.}
\[
\pi_{\text{employee-name}}(\text{employee}) - 
\pi_{\text{employee-name}} \left( 
    \sigma_{\substack{
        \text{employee.employee-id}=\text{works.employee-id} \land \\
        \text{works.company-id}=\text{company.company-id} \land \\
        \text{company.company-name}=\text{'First Bank Corporation'}
    }} 
    (\text{employee} \times \text{works} \times \text{company}) 
\right)
\]


\[
\begin{aligned}
\{ t \mid \exists e \in \text{employee} \, ( 
    & t[\text{employee-name}] = e[\text{employee-name}] \land \\
    & \neg \exists w \in \text{works}, \exists c \in \text{company} \, ( 
        e[\text{employee-id}] = w[\text{employee-id}] \land \\
        & \quad w[\text{company-id}] = c[\text{company-id}] \land \\
        & \quad c[\text{company-name}] = \text{'First Bank Corporation'} 
    ) 
) \}
\end{aligned}
\]

\[
\begin{aligned}
\{ \langle en \rangle \mid \exists eid, st, cy \, ( 
    & \langle eid, en, st, cy \rangle \in \text{employee} \land \\
    & \neg \exists cid, sal, cc \, ( 
        \langle eid, cid, sal \rangle \in \text{works} \land \\
        & \quad \langle cid, \text{'First Bank Corporation'}, cc \rangle \in \text{company}
    ) 
) \}
\end{aligned}
\]


\subsection*{3.7: Find all employees in the database who earn more than each
employee of Small Bank Corporation.}
\textbf{1} \text{Using the same relationship from the problem 2.12 but without company name}
\[
\pi_{\text{employee-name}} \left( 
    \sigma_{\text{salary} > \text{sbc\_max}} \left( 
        (\text{employee} \bowtie \text{works}) 
        \times 
        \left( \mathcal{G}_{\text{MAX}(\text{salary}) \textbf{ as } \text{sbc\_max}} ( \sigma_{\text{company-name}=\text{'Small Bank Corporation'}} (\text{works} \bowtie \text{company}) ) \right)
    \right) 
\right)
\]

\textbf{2}
\[
\begin{aligned}
\{ t \mid \exists e \in \text{employee}, \exists w \in \text{works} \, ( 
    & t[\text{employee-name}] = e[\text{employee-name}] \land \\
    & e[\text{employee-id}] = w[\text{employee-id}] \land \\
    & \forall w_2 \in \text{works}, \forall c \in \text{company} \, ( 
        (w_2[\text{company-id}] = c[\text{company-id}] \land \\
        & c[\text{company-name}] = \text{'Small Bank Corporation'}) \\
        & \implies w[\text{salary}] > w_2[\text{salary}] 
    ) 
) \}
\end{aligned}
\]
\textbf{3}
\[
\begin{aligned}
\{ \langle en \rangle \mid \exists eid, cid, sal, st, cy \, ( 
    & \langle eid, en, st, cy \rangle \in \text{employee} \land \\
    & \langle eid, cid, sal \rangle \in \text{works} \land \\
    & \forall eid_2, cid_2, sal_2, cc \, ( 
        ( \langle eid_2, cid_2, sal_2 \rangle \in \text{works} \land \\
        & \langle cid_2, \text{'Small Bank Corporation'}, cc \rangle \in \text{company} ) \\
        & \implies sal > sal_2 
    ) 
) \}
\end{aligned}
\]

\subsection*{3.8: Assume that the companies may be located in several cities. Find all
companies located in every city in which Small Bank Corporation is
located. }
\textbf{1}
\[
\pi_{\text{company-name}}(\text{company}) - 
\pi_{\text{company-name}} \left( 
    \left( \pi_{\text{company-name}}(\text{company}) \times \pi_{\text{city}} \left( \sigma_{\text{company-name}=\text{'Small Bank Corporation'}}(\text{company}) \right) \right) 
    - \pi_{\text{company-name}, \text{city}}(\text{company}) 
\right)
\]
\textbf{2}
\[
\begin{aligned}
\{ t \mid \exists c \in \text{company} \, ( 
    & t[\text{company-name}] = c[\text{company-name}] \land \\
    & \neg \exists s \in \text{company} \, ( 
        s[\text{company-name}] = \text{'Small Bank Corporation'} \land \\
        & \neg \exists c_2 \in \text{company} \, ( 
            c_2[\text{company-name}] = t[\text{company-name}] \land \\
            c_2[\text{city}] = s[\text{city}] 
        ) 
    ) 
) \}
\end{aligned}
\]
\textbf{3}
\[
\begin{aligned}
\{ \langle cn \rangle \mid \exists cid, cy \, ( 
    & \langle cid, cn, cy \rangle \in \text{company} \land \\
    & \forall cid_s, cy_s \, ( 
        \langle cid_s, \text{'Small Bank Corporation'}, cy_s \rangle \in \text{company} \\
        & \implies \exists cid_2 \, ( \langle cid_2, cn, cy_s \rangle \in \text{company} ) 
    ) 
) \}
\end{aligned}
\]



