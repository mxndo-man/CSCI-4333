\section*{Part 1}
\textbf{Relations:}
\begin{itemize}
    \item \texttt{person(driver-id, name, address)}
    \item \texttt{car(car-license, model, year)}
    \item \texttt{accident(report-number, date, location)}
    \item \texttt{owns(drive-id, car-license)}
    \item \texttt{participated(driver-id, car-license, report-number, damage amount)}
\end{itemize}

\subsection*{1.1. Find the total number of people who owned cars that were involved in an accident in 1989}
\begin{lstlisting}
SELECT COUNT(DISTINCT "driver-id")
FROM owns
WHERE ("driver-id", "car-license") IN (
  SELECT "driver-id", "car-license" 
  FROM participated 
  WHERE "report-number" IN (
    SELECT "report-number" 
    FROM accident
    WHERE date >= '1989-01-01' AND date <= '1989-12-31'
  )
);
\end{lstlisting}

\subsection*{1.2. Find the number of accidents in which the cars belonging to ``John Smith'' were involved.}
\begin{lstlisting}
SELECT COUNT(DISTINCT "report-number")
FROM  participated
WHERE ("car-license") in (
  SELECT "car-license" 
  FROM owns 
  WHERE "driver-id" in (
    SELECT "driver-id" 
    FROM  person 
    WHERE name = 'John Smith'
  )
);
\end{lstlisting}

\subsection*{1.3. Add a new accident to the database; assume any values for required attributes.}
\begin{lstlisting}
INSERT INTO accident("report-number", date, location)
VALUES ('96723423','2026-05-12','San Benito, Texas, 78586');
\end{lstlisting}

\subsection*{1.4. Delete the Mazda belonging to ``John Smith''.}
\begin{lstlisting}
DELETE FROM car
WHERE model = 'mazda' AND "car-license" IN (
  SELECT "car-license" 
  FROM owns 
  WHERE "driver-id" IN (
    SELECT "driver-id" 
    FROM person 
    WHERE name = 'John Smith'
  )
);
\end{lstlisting}

\subsection*{1.5. Update the damage amount for the car with license number ``AABB2000'' in the accident with report number ``AR2197'' to \$3000.}
\begin{lstlisting}
UPDATE participated
  SET damage-amount = 3000
  WHERE participated.car-license = 'AABB200' 
  AND participated.report-number='AR2197';
\end{lstlisting}

