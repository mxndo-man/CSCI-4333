\section*{Part 2}
\textbf{Relations:}
\begin{itemize}
    \item \texttt{employee(employee-id, employee-name, street, city)}
    \item \texttt{works(employee-id, company-id, salary)}
    \item \texttt{company(company-id, company-name, city)}
    \item \texttt{manages(employee-id, manager-id)}
\end{itemize}

\subsection*{2.1. Find the names of all employees who work for First Bank Corporation.}

\begin{lstlisting}
SELECT "employee-name"
FROM employee
WHERE "employee-id" in (
  SELECT "employee-id"
  FROM works
  WHERE "company-id" IN (
    SELECT "company-id" 
    FROM company 
    WHERE "company-name" = 'First Bank Corporation'
  )
);
\end{lstlisting}

\subsection*{2.2. Find the names and cities of residence of all employees who work for First Bank Corporation.}
\begin{lstlisting}
SELECT "employee-name", city
FROM employee
WHERE "employee-id" in (
  SELECT "employee-id"
  FROM works
  WHERE "company-id" IN (
    SELECT "company-id" 
    FROM company 
    WHERE "company-name" = 'First Bank Corporation'
  )
);
\end{lstlisting}

\subsection*{2.3. Find the names, street addresses, and cities of residence of all employees who work for First Bank Corporation and earn more than \$10,000.}
\begin{lstlisting}
SELECT "employee-name", street, city
FROM employee
WHERE "employee-id" in (
  SELECT "employee-id"
  FROM works
  WHERE salary > 10000 and "company-id" IN (
    SELECT "company-id" 
    FROM company 
    WHERE "company-name" = 'First Bank Corporation'
  )
);
\end{lstlisting}

\subsection*{2.4. Find all employees in the database who live in the same cities as the companies for which they work.}
\begin{lstlisting}
SELECT "employee-name"
FROM employee
WHERE city IN (
  SELECT city 
  FROM company 
  WHERE "company-id" IN (
    SELECT "company-id" 
    FROM works 
    WHERE employee."employee-id" = works."employee-id"
  )
);
\end{lstlisting}

\subsection*{2.5. Find all employees in the database who live in the same cities and on the same streets as do their managers.}
\begin{lstlisting}
SELECT e."employee-name" 
FROM employee as e, employee as m, manages as mg 
WHERE e."employee-id" = mg."employee-id"
  AND m."employee-id" = mg."manager-id"
  AND e.street = m.street
  AND e.city = m.city;
\end{lstlisting}

\subsection*{2.6. Find all employees in the database who do not work for the First Bank Corporation.}
\begin{lstlisting}
SELECT "employee-name"
FROM employee 
WHERE "employee-id" NOT IN (
  SELECT "employee-id" 
  FROM works 
  WHERE "company-id" IN (
    SELECT "company-id" 
    FROM company 
    WHERE "company-name" = 'First Bank Corporation'
  )
);
\end{lstlisting}

\subsection*{2.7. Find all employees in the database who earn more than each employee of Small Bank Corporation.}
\begin{lstlisting}
SELECT "employee-name"
FROM employee 
WHERE "employee-id" IN (
  SELECT "employee-id" 
  FROM WORKS 
  WHERE salary > ALL (
    SELECT salary 
    FROM works 
    WHERE "company-id" IN (
      SELECT "company-id" 
      FROM company 
      WHERE "company-name" = "Small Bank Corporation"
    )
  )
);
\end{lstlisting}

\subsection*{2.8. Assume that the companies may be located in several cities. Find all companies located in every city in which Small Bank Corporation is located.}
\begin{lstlisting}
SELECT c."company-name"
FROM company as c
WHERE NOT EXISTS (
  SELECT sbc.city
  FROM company as sbc
  WHERE sbc."company-name" = 'Small Bank Corportaion'
    AND sbc.city NOT IN (
      SELECT c2.city
      FROM company as c2
      WHERE c2."company-name" = c."company-name"
    )
);
\end{lstlisting}

\subsection*{2.9. Find all employees who earn more than the average salary of all employees of their company.}
\begin{lstlisting}
SELECT e."employee-name"
FROM employee as e
join works as wEmp on wEmp."employee-id" = e."employee-id"
WHERE works.salary > (
  SELECT AVG(w.salary)
  FROM works as w
  WHERE  wEmp."company-id" = w."company-id"
);
\end{lstlisting}

\subsection*{2.10. Find the company that has the most employees.}
\begin{lstlisting}
SELECT c."company-name"
FROM  company as c 
WHERE c."company-id" in (
  SELECT "company-id" 
  FROM  works 
  GROUP BY "company-id" HAVING COUNT(DISTINCT "employee-id") >= ALL (
    SELECT COUNT (DISTINCT "employee-id") 
    FROM works 
    GROUP BY "company-id"
  )
);
\end{lstlisting}

\subsection*{2.11. Find the company that has the smallest payroll.}
\begin{lstlisting}
SELECT c."company-name"
FROM company as c
JOIN works as wEmp on wEmp."company-id" = c."company-id"
GROUP BY c."company-id", c."company-name"
HAVING sum(wEmp.salary) <= ALL (
  SELECT SUM (salary)
  FROM works
  GROUP BY "company-id"
);
\end{lstlisting}

\subsection*{2.12. Find those companies whose employees earn a higher salary, on average, than the average of First Bank Corporation.}
\begin{lstlisting}
SELECT c."company-name"
FROM company as c
JOIN works as wHigh ON wHigh."company-id" = c."company-id"
GROUP BY c."company-id", c."company-name"
HAVING AVG(wHigh.salary) > (
  SELECT AVG(salary)
  FROM works
  WHERE "company-id" IN (
    SELECT "company-id" 
    FROM company 
    WHERE "company-name" = 'First Bank Corporation'
  )
);
\end{lstlisting}

\subsection*{3.1 Relational algebra expression, Tuple relational calculus, domain relational calculus expression}
\textbf{1}
\[
\pi_{\text{employee.employee-name}} \left( 
    \sigma_{\substack{
        \text{employee.employee-id}=\text{works.employee-id} \wedge \\
        \text{works.company-id}=\text{company.company-id} \wedge \\
        \text{company.company-name}=\text{'First Bank Corporation'}
    }} 
    (\text{employee} \times \text{company} \times \text{works}) 
\right)
\]
\textbf{2}
\[
\begin{aligned}
\{ t \mid \exists e \in \text{employee}, w \in \text{works}, c \in \text{company} \, ( 
    & t[\text{employee-name}] = e[\text{employee-name}] \land \\
    & e[\text{employee-id}] = w[\text{employee-id}] \land \\
    & w[\text{company-id}] = c[\text{company-id}] \land \\
    & c[\text{company-name}] = \text{'First Bank Corporation'} 
) \}
\end{aligned}
\]
\textbf{3}
\[
\begin{aligned}
\{ \langle en \rangle \mid \exists eid, st, cy, cid, sal, cc \, ( 
    & \langle eid, en, st, cy \rangle \in \text{employee} \land \\
    & \langle eid, cid, sal \rangle \in \text{works} \land \\
    & \langle cid, \text{'First Bank Corporation'}, cc \rangle \in \text{company} 
) \}
\end{aligned}
\]

